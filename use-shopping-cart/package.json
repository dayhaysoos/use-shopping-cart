{
  "name": "use-shopping-cart",
  "version": "4.0.0-rc.1",
  "description": "Shopping cart state and logic for Stripe",
  "author": "dayhaysoos",
  "license": "MIT",
  "repository": "dayhaysoos/use-shopping-cart",
  "main": "dist/react.cjs",
  "types": "dist/react.d.ts",
  "module": "dist/react.mjs",
  "unpkg": "dist/react.umd.js",
  "umd": "dist/react.umd.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./utilities": {
      "import": {
        "types": "./dist/utilities.d.mts",
        "default": "./dist/utilities.mjs"
      },
      "require": {
        "types": "./dist/utilities.d.cts",
        "default": "./dist/utilities.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "utilities": [
        "./dist/utilities.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc -p tsconfig.json",
    "test:types": "tsc -p tsconfig.types.json",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "check:package": "publint --strict && attw --pack .",
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "prepublishOnly": "pnpm build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-sucrase": "^5.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.67.3",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-node-externals": "^8.1.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
